<h2>Add New Book</h2>

<form action="/admin/books/new" method="POST" enctype="multipart/form-data">
  <label for="title">Title:</label>
  <input type="text" name="title" id="title" placeholder="Book title" required>

  <label for="author">Author:</label>
  <select name="author" id="author" required>
    {{#each authors}}
      <option value="{{this.id}}">{{this.name}}</option>
    {{/each}}
  </select>

  <label for="description">Description:</label>
  <textarea name="description" id="description" placeholder="Book description"></textarea>

  <label for="image">Book Cover (PNG/JPG):</label>
  <input type="file" name="image" id="image" accept="image/png, image/jpeg">

  <button type="submit">Add Book</button>
</form>
