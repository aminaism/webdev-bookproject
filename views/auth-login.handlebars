<h1>Login</h1>

{{#if error}}
<p style="color:red">{{error}}</p>
{{/if}}

<form method="post" action="/auth/login">
  <label>Username<br>
    <input type="text" name="username" required>
  </label><br><br>

  <label>Password<br>
    <input type="password" name="password" required>
  </label><br><br>

  <button type="submit">Login</button>
</form>
